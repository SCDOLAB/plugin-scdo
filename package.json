{
  "name": "@scdo/plugin-scdo",
  "version": "0.1.1",
  "description": "SCDO x402 for ElizaOS: a per-agent wallet (USDC on Base via x402), signed heartbeats and booked income on the SCDO Agent Ledger, a bookkeeping ledger service.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCDOLAB/plugin-scdo.git"
  },
  "homepage": "https://scdo.com.au/linux-agent/",
  "author": "SCDO Lab",
  "keywords": [
    "elizaos",
    "elizaos-plugins",
    "elizaos-plugin",
    "eliza-plugin",
    "plugin",
    "x402",
    "wallet",
    "usdc",
    "base",
    "scdo",
    "ledger"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test __tests__/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "scdo-agent-mcp": "https://github.com/SCDOLAB/scdo-agent-plugins/releases/download/v0.1.0/scdo-agent-mcp-0.1.0.tgz"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elizaos/core": "^1.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "SCDO_AGENT_BOT": {
        "type": "string",
        "description": "Local agent name (default: the character name)"
      },
      "SCDO_AGENT_NETWORK": {
        "type": "string",
        "description": "base (mainnet) or base-sepolia (testnet)",
        "defaultValue": "base"
      },
      "SCDO_AGENT_DATA": {
        "type": "string",
        "description": "scdo-agent data directory (keys stay here and are never sent or printed)"
      },
      "SCDO_AGENT_AUTOSTART": {
        "type": "boolean",
        "description": "Register, start heartbeats and create the wallet on start",
        "defaultValue": "true"
      },
      "SCDO_AGENT_MAX_USDC": {
        "type": "string",
        "description": "Max USDC per x402 payment (0.001 to 1)",
        "defaultValue": "0.10"
      },
      "SCDO_AGENT_DAILY_USDC": {
        "type": "string",
        "description": "Daily USDC budget (up to 20)",
        "defaultValue": "1.00"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/SCDOLAB/plugin-scdo/issues"
  }
}
